# === Portfolio Manager — .env ===
# Copy to .env and fill in. The real .env is gitignored.
# Harness/model config (Qwen 3.8 tag) lives on the 4090 in the harness's
# own config; the Pi's WOL service config lives on the Pi — neither is here.

# --- Collection (1080) ---
WATCHLIST=SPY,QQQ,TLT,GLD
PRICE_SOURCE=auto            # auto | yahoo | stooq
PRICE_HISTORY_RANGE=1mo      # daily history depth per price fetch
FRED_API_KEY=                # REQUIRED: free key from the FRED API docs
FRED_SERIES=DFF,T10Y3M,CPIAUCSL,UNRATE,UMCSENT
NEWS_FEEDS=https://feeds.content.dowjones.io/public/rss/mw_topstories
NEWS_CRAWL_PAGES=            # comma-separated allowlisted free pages (light crawl)

# --- 1080 read-only LAN API ---
API_HOST=0.0.0.0
API_PORT=8400

# --- WOL (1080 identity; the Pi is the always-on anchor that sends WOL) ---
WOL_TARGET_MAC=
WOL_TARGET_IP=
WOL_SCHEDULE=daily 06:00
WOL_TIMEOUT_S=120
PI_HOST=

# --- Simulated portfolio (v1) ---
PORTFOLIO_START_BALANCE=10000    # $5,000-$10,000 regime
PORTFOLIO_START_POSITIONS=       # optional ticker:shares pairs
TX_COST_BPS=5                    # assumed transaction cost per paper trade
BENCHMARK_TIKER=SPY

# --- Team sessions (4090) ---
SESSION_TIMEOUT_HOURS=4
DELIBERATION_MAX_ROUNDS=6
POD_MAX_ROLES=3
POD_MAX_PODS=5
KOBOLDCPP_URL=http://localhost:5001   # programmatic role invocation (team/session.py)

# --- Conversation history ---
HISTORY_WINDOW_SESSIONS=30
HISTORY_CAP_MB=500

# --- Code sync (4090 push -> 1080 auto-pull) ---
AUTOPULL_INTERVAL_MIN=15
SMOKE_TEST_TIMEOUT_S=300
SELF_MOD_MAX_ESCALATIONS=3
REPO_REMOTE_URL=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_TO=

# --- Dashboard (LAN) ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8300

# --- Archives ---
ARCHIVE_CAP_GB=20
